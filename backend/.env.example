# HaizhuProxy backend env example — copy to .env
HZ_SECRET_KEY=replace-with-long-random-string
HZ_DATABASE_URL=sqlite:///./data/haizhu.db
# HZ_DATABASE_URL=postgresql+psycopg2://haizhu:pass@localhost/haizhu
HZ_REGISTER_ENABLED=true
HZ_INVITE_REQUIRED=false
HZ_INVITE_BONUS_MB=1024
HZ_NEW_USER_BONUS_MB=0
